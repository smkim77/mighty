; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="마이티 (Mighty) - C# 1인용 카드 게임"
config/description="Godot 4 .NET (C#) 기반 5인용 한국형 트릭테이킹 카드 게임 마이티(Mighty)"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

general/default_playback_type.web=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Mighty"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.06, 0.16, 0.12, 1)
